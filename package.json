{
  "name": "airemoteworkdashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next typegen && eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts",
    "functions:check": "deno check --config supabase/functions/ingest/deno.json supabase/functions/ingest/index.ts && deno check --config supabase/functions/inbound-email/deno.json supabase/functions/inbound-email/index.ts && deno check --config supabase/functions/tailor-resume/deno.json supabase/functions/tailor-resume/index.ts && deno check --config supabase/functions/job-description/deno.json supabase/functions/job-description/index.ts && deno check --config supabase/functions/newsletter-image/deno.json supabase/functions/newsletter-image/index.ts && deno lint --no-config supabase/functions",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.11.0",
    "lucide-react": "^1.49.0",
    "mammoth": "^1.13.0",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "6.11.0",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
